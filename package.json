{
  "name": "enterprise-app-marketplace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "temporal:check": "tsc --noEmit",
    "temporal:bundle": "tsx src/temporal/bundle-check.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.4",
    "next": "16.3.8",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@temporalio/worker": "1.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.25.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "tsx": "4.23.15"
  }
}
