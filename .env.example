DATABASE_URL=postgresql://market:localdev@localhost:5432/market
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-secure-random-secret-of-32-chars

# Optional: only use a client-IP header overwritten by a trusted reverse proxy.
# Without this setting, auth requests share a conservative per-path limit.
# AUTH_TRUSTED_IP_HEADER=x-market-client-ip

# Optional P1-02: GitHub public repositories work without credentials.
# For private repositories use a fine-grained read-only token, server-side only:
# GITHUB_READ_TOKEN=
# GITHUB_ALLOWED_REPOS=owner/repository,organization/other-repository
# A token is NEVER sent for a repository not explicitly in this allowlist.

# Optional P4: Argo CD read-only Applications API integration.
# HTTPS is required outside localhost; token stays server-side.
# Limit the token to applications:get/list in the named Argo project(s).
# ARGOCD_SERVER_URL=https://argocd.example.internal
# ARGOCD_READ_TOKEN=
# ARGOCD_ALLOWED_PROJECTS=marketplace-lab,marketplace-hosted

# P4 lab-only GitOps PR dispatch. Both must stay server-side.
# P4_DEPLOY_OPERATOR_IDS=<portal-user-id>
# P4_GITHUB_DISPATCH_TOKEN=
# Optional experimental monitoring and local AI read-only diagnosis.
# P4_MONITORED_NAMESPACE=marketplace-lab
# PROMETHEUS_SERVER_URL=http://127.0.0.1:9090
# LOKI_SERVER_URL=http://127.0.0.1:3100
# Hosted LLM (DeepSeek default, OpenAI-compatible providers supported); server-side only.
# DEEPSEEK_API_KEY=
# AIOPS_LLM_API_KEY=  # Optional alternative to DEEPSEEK_API_KEY
# AIOPS_LLM_BASE_URL=https://api.deepseek.com
# AIOPS_LLM_MODEL=deepseek-flash
# AIOPS_LLM_SEND_LOGS=false  # false by default; never send raw logs unless explicitly enabled

# P4 Rollouts operations use a separate tightly-scoped Argo token.
# ARGOCD_ACTION_TOKEN=

# P5 GitHub Copilot Cloud Agent (paid Copilot; user-to-server token, not installation token)
# P5_COPILOT_USER_TOKEN=
# P5_ALLOWED_REPOS=NoName4Me/enterprise-app-marketplace

# Unified OrbStack Kubernetes deployment: see docs/MAC_MINI_SETUP.md.
# In Kubernetes the Portal and Activity Worker both connect over cluster DNS:
# TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
# TEMPORAL_NAMESPACE=default
# Existing DATABASE_URL must be rewritten for pod-to-Compose PostgreSQL networking
# (do not use localhost:5432 inside a Pod).
# Examples for Kubernetes *server-side* runtime env file:
# DATABASE_URL=postgresql://market:<existing-password>@host.docker.internal:5432/market
# BETTER_AUTH_URL=http://portal.k8s.orb.local
# ARGOCD_SERVER_URL=http://argocd-server.argocd.svc.cluster.local
# PROMETHEUS_SERVER_URL=http://monitor-kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
# LOKI_SERVER_URL=http://loki-gateway.monitoring.svc.cluster.local:80
# Temporal admin DB password must NOT be put here or committed;
# create temporal-db-secret in the temporal namespace from local .env.temporal.pg.
# Use a separate .env.worker.k8s for only DeepSeek and GitHub Coding Agent credentials.

# Hosted app access: stable LAN IPv4 of Mac mini; UI only exposes verified deployments
# HOSTED_PUBLIC_IP=192.168.1.20
# Application NodePort reservations: fixed 31000-31999 (must check real K8s conflicts)

# HOSTED app deployment — namespace/port reservation is automatic, not a user field.
# Portal-only allowlist. Repo owners cannot grant themselves arbitrary source access.
# HOSTED_ALLOWED_REPOS=example/portal-app
# HOSTED_PUBLIC_IP=192.168.1.20
# P4_DEPLOY_OPERATOR_IDS=<approved-owner-user-id>
# Worker-only secrets (portal-worker-runtime), NEVER expose to source repository:
# DATABASE_URL=postgresql://market:<password>@host.docker.internal:5432/market
# HOSTED_GITHUB_SOURCE_TOKEN=<read-write-Actions-and-read-Deployments-token>
# HOSTED_GITOPS_TOKEN=<only-this-platform-repository-Contents+PR-token>
# HOSTED_ARGO_APPLICATION_TOKEN=<restricted-Argo-project-create-get-token>
# ARGOCD_SERVER_URL=http://argocd-server.argocd.svc.cluster.local
# HOSTED_PUBLIC_IP=192.168.1.20
