DATABASE_URL=postgresql://market:localdev@localhost:5432/market
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-secure-random-secret-of-32-chars

# Optional: only use a client-IP header overwritten by a trusted reverse proxy.
# Without this setting, auth requests share a conservative per-path limit.
# AUTH_TRUSTED_IP_HEADER=x-market-client-ip

# Optional P1-02: GitHub public repositories work without credentials.
# For private repositories use a fine-grained read-only token, server-side only:
# GITHUB_READ_TOKEN=
# GITHUB_ALLOWED_REPOS=owner/repository,organization/other-repository
# A token is NEVER sent for a repository not explicitly in this allowlist.

# Optional P4: Argo CD read-only Applications API integration.
# HTTPS is required outside localhost; token stays server-side.
# Limit the token to applications:get/list in the named Argo project(s).
# ARGOCD_SERVER_URL=https://argocd.example.internal
# ARGOCD_READ_TOKEN=
# ARGOCD_ALLOWED_PROJECTS=marketplace-lab

# P4 lab-only GitOps PR dispatch. Both must stay server-side.
# P4_DEPLOY_OPERATOR_IDS=<portal-user-id>
# P4_GITHUB_DISPATCH_TOKEN=
# Optional experimental monitoring and local AI read-only diagnosis.
# P4_MONITORED_NAMESPACE=marketplace-lab
# PROMETHEUS_SERVER_URL=http://127.0.0.1:9090
# LOKI_SERVER_URL=http://127.0.0.1:3100
# AIOPS_OLLAMA_URL=http://127.0.0.1:11434
# AIOPS_MODEL=<local-ollama-model>
