-- Execute ONLY against the existing PostgreSQL instance as its database admin.
-- No DROP, TRUNCATE, migration of the market database, or volume changes.
-- Run with psql -v ON_ERROR_STOP=1 -U market -d postgres.
-- Password and LOGIN are set separately with psql's interactive \password.
SELECT 'CREATE ROLE temporal_user NOLOGIN'
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'temporal_user') \gexec
SELECT 'CREATE DATABASE temporal OWNER temporal_user'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'temporal') \gexec
SELECT 'CREATE DATABASE temporal_visibility OWNER temporal_user'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'temporal_visibility') \gexec
